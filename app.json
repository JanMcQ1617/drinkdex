{
  "expo": {
    "name": "Sipply",
    "slug": "drinkdex",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drinkdex",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDF9",
    "ios": {
      "bundleIdentifier": "com.janmcqueeny.drinkdex",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B0F1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9E5DF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Sipply matches your contacts against people already on Sipply so you can follow friends you already know. Your contacts are never uploaded — only one-way hashes are compared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
